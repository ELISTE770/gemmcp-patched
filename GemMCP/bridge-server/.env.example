# GemMCP Bridge Server Configuration
# העתק את הקובץ הזה ל-.env באותה תיקייה, וערוך לפי הצורך.

PORT=3000

# ---------------------------------------------------------------------------
# הרשאות Windows - ברירות מחדל בצד השרת
#
# אזהרה: אלה ברירות מחדל בלבד. הפונקציה resolvePermissions ב-server.js
# מאפשרת לגוף הבקשה לדרוס אותן. ההגנה האפקטיבית היא המתג
# "Auto-Run Approval" בתוסף - השאר אותו כבוי.
# ---------------------------------------------------------------------------
WIN_PERM_READ=true
WIN_PERM_WRITE=false
WIN_PERM_COMMANDS=false
WIN_PERM_APPS=true
WIN_PERM_CLIPBOARD=true

# הגבלת כל גישה לקבצים לעץ תיקיות אחד.
# ריק או לא מוגדר = שולחן העבודה (ברירת מחדל שמרנית).
# כדי לפתוח את כל הדיסק צריך להצהיר על כך במפורש: WIN_ALLOWED_PATH=*
WIN_ALLOWED_PATH=C:\Users\YOUR_NAME\Desktop

# שאילתות כתיבה ל-Supabase. ברירת המחדל היא קריאה בלבד.
SUPABASE_ALLOW_WRITES=false

# Token אימות הגשר - חובה.
# אם משאירים בהערה, השרת מגריל טוקן בהפעלה הראשונה, מדפיס אותו לחלון וכותב
# אותו ל-bridge-server/.token. יש להעתיק אותו פעם אחת להגדרות התוסף.
# BRIDGE_AUTH_TOKEN=

# Supabase Vault (אופציונלי - רק אם משתמשים ב-Supabase MCP)
# SUPABASE_URL=
# SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=

# OAuth App Credentials (אופציונלי)
# NOTION_CLIENT_ID=
# NOTION_CLIENT_SECRET=
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# SUPABASE_CLIENT_ID=
# SUPABASE_CLIENT_SECRET=
